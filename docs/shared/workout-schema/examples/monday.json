      "parts": [
        {
          "part_id": "b3-pA",
          "structure": "TEXT",
          "title": "Find a 3RM",
          "lines": [
            "10 minutes",
            "Minimum 5 progressive sets to find the heaviest added load for 3 strict pull-ups",
            "Ramp-up: 5 bodyweight, 3 light, 3 moderate, 2-3 heavier, continue to the day's 3RM"
          ],
          "label": "A"
        },
        {
          "part_id": "b3-pB",
          "structure": "TEXT",
          "title": "Strength endurance",
          "lines": [
            "2 sets of max reps",
            "Load: 20% of the added weight used for the 3RM in Part A",
            "Example: 50 lb 3RM -> 10 lb for max reps sets"
          ],
          "label": "B"
        }
      ],
      "coaching": {
        "intention": "Develop maximal pulling strength, then test reps with a lighter load.",
        "form_cues": [
          "Start from dead hang",
          "Abs and glutes active",
          "Chin clearly over the bar",
          "No hip kipping"
        ],
